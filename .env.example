# Copy this file to `.env.local` at the project root (next to `package.json`).
# Next.js does **not** load `.env.example` at runtime — only `.env*` (e.g. `.env.local`).
#
# ── Local development (Docker) ───────────────────────────────────────────────
# 1. Open Docker Desktop and wait until it is "Running".
# 2. From the project root: npm run db:up
# 3. Set DATABASE_URL to the local proxy string from your Neon/Docker setup.
#    Host db.localtest.me resolves to 127.0.0.1 (needs internet or a hosts entry).
#    If it fails, add to your hosts file: 127.0.0.1 db.localtest.me
#
# ── Neon cloud (production / staging) ────────────────────────────────────────
# Paste the pooled connection string from the Neon dashboard into `.env.local`.
# Never commit that value. If the dashboard adds channel_binding=require, you can
# leave it — the app strips it for @neondatabase/serverless.
DATABASE_URL=

# Neon Auth — Auth URL in the console (Project → Auth). Cookie secret: openssl rand -base64 32
# NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=

# Public URL (email links, Neon Auth webhook, Google Calendar).
# Must be HTTPS reachable on the internet — Google Calendar and Neon Auth do not use localhost.
# On Vercel you can omit this if you rely on VERCEL_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Auth — verification emails using the +54 template (logo).
# In the Neon console: Auth → Configuration → Webhooks
# URL: https://YOUR-DOMAIN/api/auth/neon-webhook
# Events: send.otp and send.magic_link
# (localhost will not work; you need public HTTPS.)

# Calendar feed secret (automatic subscription on the phone).
# CALENDAR_FEED_SECRET=

# Session cookie signature (prevents forging userId). If empty, uses NEON_AUTH_COOKIE_SECRET.
# SESSION_COOKIE_SECRET=

# Local bootstrap scripts only — never commit the real value.
# SEED_PASSWORD=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_COACH_PASSWORD=
PASSWORD_RESET_DISABLE_SEND=1

# Confirmed lesson: ICS invite over SMTP. To log only in the terminal: LESSON_CALENDAR_DISABLE_SEND=1
# LESSON_CALENDAR_DISABLE_SEND=1

# Nodemailer (Gmail: smtp.gmail.com + app password; Outlook: smtp-mail.outlook.com).
# Port 587 + SMTP_SECURE=0 (STARTTLS). Gmail: Google account → Security → App passwords.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=+54 <you@email.com>

# Another log-only mode (no SMTP_* required): PASSWORD_RESET_LOG_TOKEN=1
# PASSWORD_RESET_LOG_TOKEN=1
